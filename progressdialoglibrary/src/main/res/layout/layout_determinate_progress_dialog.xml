<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/textView_determinate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:ellipsize="none"
        android:maxEms="26"
        android:scrollHorizontally="false"
        android:text="@string/loading"
        android:textColor="@color/black"
        android:textSize="17sp"
        app:layout_constraintBottom_toTopOf="@id/progressbar_determinate"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressbar_determinate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:indeterminate="false"
        android:padding="6dp"
        app:indicatorColor="?attr/colorPrimary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textView_determinate"
        app:trackThickness="4dp" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/progressTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="4dp"
        android:textColor="@color/black_light"
        android:textSize="13sp"
        app:layout_constraintStart_toStartOf="@id/progressbar_determinate"
        app:layout_constraintTop_toBottomOf="@id/progressbar_determinate"
        tools:text="Progress: 0%" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/timeElapsedTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/time_elapsed_0h_0m_0s"
        android:textColor="@color/black_light"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="@id/progressbar_determinate"
        app:layout_constraintTop_toBottomOf="@id/progressbar_determinate"
        tools:text="00h: 00m: 00s" />
</androidx.constraintlayout.widget.ConstraintLayout>